# Copy to .env and fill in. .env is git-ignored; never commit credentials.

# Local Clotho v2.1 copy (contains audio/, captions/, metadata/, manifests/).
CLOTHO_ROOT=/path/to/DATASETS/Clotho

# API models (E06, E07).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hugging Face: gated checkpoints and HF Jobs (E08, E09).
HF_TOKEN=
